# After cloning: run supabase/migrations 001→005 in order (see docs/COMMAND_CENTER.md).
# 004_concierge.sql + 005_command_center.sql are both required for bookings + /admin.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Canonical site URL — used for QR verification links (/verify/{customerNumber})
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PANORA_WHATSAPP=263715708327
NEXT_PUBLIC_PANORA_EMAIL=info@panora.co.zw
NEXT_PUBLIC_PANORA_PHONE=+263715535982
NEXT_PUBLIC_PANORA_PHONE_DISPLAY=+263 71 553 5982
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_HERO_VIDEO=/videos/hero.mp4
# Google Maps JavaScript + Directions + Places (Nearby). Without this key,
# venue/explore maps fall back to an elegant embed / stylised map and never break the page.
# Enable: Maps JavaScript API, Directions API, Places API (and billing) in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_X=
# Service role: QR/ticket uploads to Storage + privileged booking writes
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# Optional guest emails via Resend. If unset, enquiry still saves; email failure is logged only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Panora Go <onboarding@resend.dev>
