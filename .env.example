# Panora Go — environment template
# Copy to `.env.local` for local Next.js. Set the same keys in Vercel → Settings → Environment Variables.
# Values left empty on purpose — fill from Supabase / Resend / Google Cloud dashboards.
# After cloning: run supabase/migrations 001→007 in order (see docs/COMMAND_CENTER.md).

# --- Required for Auth, Admin, live Supabase data ---------------------------------
# Without these, public pages fall back to curated seed places; admin/auth will not work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL (no trailing slash). Used for QR/verify links, OG metadata, sitemap, CSRF allowlist.
# Required in production. On Vercel, a leftover localhost value is ignored in favour of VERCEL_* URLs.
# Local default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# --- Server-only (never expose to the browser) ------------------------------------
# Ticket/QR uploads to Storage, durable rate-limit/token tables, privileged booking writes,
# admin bootstrap (first login creates victorm@… when missing), and Users → Create account.
# Without it: browse + enquiry can still work via anon/user client; storage uploads & durable guards degrade.
# See docs/COMMAND_CENTER.md for first-admin bootstrap steps (do not put real passwords here).
SUPABASE_SERVICE_ROLE_KEY=

# Optional guest emails via Resend. If unset, enquiry still saves; email failure is logged only.
RESEND_API_KEY=
# Defaults to "Panora Go <onboarding@resend.dev>" when RESEND_API_KEY is set but this is empty.
RESEND_FROM_EMAIL=

# --- Concierge contacts (public; hardcoded fallbacks exist in code) ---------------
# WhatsApp: digits with country code, no + or spaces (e.g. 2637…).
NEXT_PUBLIC_PANORA_WHATSAPP=
NEXT_PUBLIC_PANORA_EMAIL=
NEXT_PUBLIC_PANORA_PHONE=
NEXT_PUBLIC_PANORA_PHONE_DISPLAY=

# --- Optional product integrations ------------------------------------------------
# Google Maps JavaScript + Directions + Places (Nearby). Without this key,
# venue/explore maps fall back to an elegant embed / stylised map and never break the page.
# Enable: Maps JavaScript API, Directions API, Places API (and billing) in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional hero MP4/WebM URL or public path. When unset, the static Zimbabwe hero photo is used.
NEXT_PUBLIC_HERO_VIDEO=

# Plausible analytics domain (e.g. panora.co.zw). When unset, no analytics script is loaded.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Footer social links — omitted from the UI when empty.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_X=
